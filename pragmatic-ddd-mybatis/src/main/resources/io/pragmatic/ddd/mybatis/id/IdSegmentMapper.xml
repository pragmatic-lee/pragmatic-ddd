<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  IdSegmentMapper 契约接口的 SQL 实现。
  namespace 必须等于被注册的契约接口全限定名，MyBatis 才能将 XML 中的语句绑定到该接口。
  表名 id_segment 通过 ${idSegmentTable} 占位符注入（由 MybatisModuleBootstrap 统一设置，
  schema 建表脚本使用同一占位符），引用方已有同名业务表时改配置即可，无需改动本文件。
  本文件即“当前数据库实现（MySQL）”，未来要支持其他数据库，只需提供同名
 （namespace 同为 io.pragmatic.ddd.mybatis.id.IdSegmentMapper）的 XML 替换即可，
  DbSegmentAllocator 等使用方代码无需任何改动。
-->
<mapper namespace="io.pragmatic.ddd.mybatis.id.IdSegmentMapper">

    <resultMap id="IdSegmentResult" type="io.pragmatic.ddd.mybatis.id.IdSegmentEntity">
        <id column="biz_key" property="bizKey"/>
        <result column="current_max_id" property="currentMaxId"/>
        <result column="step" property="step"/>
        <result column="version" property="version"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <select id="selectForUpdate" resultMap="IdSegmentResult">
        SELECT biz_key, current_max_id, step, version, remark
        FROM ${idSegmentTable}
        WHERE biz_key = #{bizKey} FOR UPDATE
    </select>

    <update id="incrementMax">
        UPDATE ${idSegmentTable}
        SET current_max_id = #{newMax}, version = version + 1, updated_at = NOW()
        WHERE biz_key = #{bizKey}
    </update>

</mapper>
