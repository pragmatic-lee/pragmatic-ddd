<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pragmatic-ddd</groupId>
        <artifactId>pragmatic-ddd-parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pragmatic-ddd-parent</relativePath>
    </parent>

    <artifactId>pragmatic-ddd-spring-boot</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>Pragmatic DDD Spring Boot Starter</name>
    <description>Spring Boot auto-configuration starter for Pragmatic DDD: bridges the framework's
        Spring-agnostic ports (TransactionOperations, statement executors, configuration source) and
        auto-assembles the transaction / outbox / event-bus / id / compensation chains.</description>

    <properties>
        <spring-boot.version>3.2.4</spring-boot.version>
        <mybatis-spring.version>3.0.4</mybatis-spring.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 仅管理 Spring Boot 生态版本，向下兼容使用方，不锁死高版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 框架内核（必选） -->
        <dependency>
            <groupId>com.pragmatic-ddd</groupId>
            <artifactId>pragmatic-ddd-core</artifactId>
            <version>${pragmatic-ddd.version}</version>
        </dependency>

        <!-- Spring Boot 自动装配底座（引入 spring-context / spring-core 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 事务桥接所需：PlatformTransactionManager / TransactionTemplate（使用方自带 JDBC 时已在容器） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MyBatis 持久化桥接（可选：无此依赖时 outbox / id 自动装配整块跳过） -->
        <dependency>
            <groupId>com.pragmatic-ddd</groupId>
            <artifactId>pragmatic-ddd-mybatis</artifactId>
            <version>${pragmatic-ddd.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>${mybatis-spring.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 事件总线实现（可选：按 event.bus 择一生效） -->
        <dependency>
            <groupId>com.pragmatic-ddd</groupId>
            <artifactId>pragmatic-ddd-rocketmq</artifactId>
            <version>${pragmatic-ddd.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.pragmatic-ddd</groupId>
            <artifactId>pragmatic-ddd-kafka</artifactId>
            <version>${pragmatic-ddd.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 配置元数据处理器：为 pragmatic-ddd.* 属性提供 IDE 补全 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok（实体 / 配置类简化） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 覆写父 POM 锁定的处理器路径：保留 lombok，追加 spring-boot 排序与配置元数据处理器，
                         使 @AutoConfiguration(after=...) 的排序元数据在编译期生成到
                         META-INF/spring-autoconfigure-metadata.properties -->
                    <annotationProcessorPaths combine.self="override">
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-autoconfigure-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!--
                            本模块的自动装配测试使用 Mockito 内联 mock；当运行 JDK 高于所用
                            ByteBuddy 的正式支持版本（如本机 JDK 26）时，mock 会因类文件版本过新而失败。
                            开启实验性支持即可，不改变任何被测行为；与父 POM 的 argLine 互不冲突。
                        -->
                        <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
